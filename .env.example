# Copy this file to .env and fill in your own values.
# Nothing loads it automatically: the Vast job reads -e KEY=VALUE flags from
# the Docker options. Treat this as a checklist, or export it locally with
#   set -a; source .env; set +a
#
# .env is gitignored. Do not put real tokens in this file, in the launch
# template, or in any commit.

# --- Credentials -------------------------------------------------------------
# Roboflow > Settings > API Key. Needed when a source spec starts with roboflow:
ROBOFLOW_API_KEY=REPLACE_WITH_ROBOFLOW_API_KEY

# Hugging Face token with write access. Used for uploads and hf: dataset specs.
HF_TOKEN=REPLACE_WITH_HF_WRITE_TOKEN

# Private model repo that receives best.pt, best.onnx, plots and metrics.
HF_MODEL_REPO=your-hf-user/your-private-model-repo

# Password for JupyterLab on the Vast instance. Use a long random string;
# port 8888 is exposed and the script refuses to start with this empty.
JUPYTER_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING

# --- Datasets ----------------------------------------------------------------
# Comma-separated source specs. Format is documented in scripts/sources.py.
PRETRAIN_SOURCES=roboflow:your-workspace/your-project/1
FINETUNE_SOURCE=

# Legacy single-source path, used only when PRETRAIN_SOURCES is empty.
DATASET_SOURCE=roboflow
ROBOFLOW_WORKSPACE=your-workspace
ROBOFLOW_PROJECT=your-project
ROBOFLOW_VERSION=1
HF_DATASET_REPO=your-hf-user/your-private-dataset-repo
ROBOFLOW_FORMAT=yolov8
POOL_DROP_CLASSES=contour,target,sticker,shell,casing,hull

# --- Training ----------------------------------------------------------------
# Defaults live in configs/train_config.yaml. Override only what you need.
MODEL=yolo11s.pt
IMGSZ=960
EPOCHS=150
FINETUNE_EPOCHS=40
BATCH=16
PATIENCE=40
DEVICE=0
CACHE=ram
RUN_NAME=rc-bullethole
VAL_FRACTION=0.15
SPLIT_SEED=0

# --- Runtime -----------------------------------------------------------------
ENABLE_JUPYTER=true
OPEN_BUTTON_PORT=8888
# Leave empty; provision.sh generates a UTC timestamp for the artifact folder.
RUN_STAMP=
